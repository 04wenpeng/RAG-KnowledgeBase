# —————————— 大模型（可选，不配也能用：走离线抽取式回答）——————————
# 三选一，填好保存为 .env 即可自动生效（本文件是模板，复制成 .env 再改）

# 方案 A：阿里云百炼（课件 P10-P14 的方案，推荐，有免费额度）
# LLM_PROVIDER=dashscope
# DASHSCOPE_API_KEY=sk-你的百炼Key
# LLM_MODEL=qwen-plus
# EMBEDDING_MODEL=text-embedding-v1

# 方案 B：DeepSeek（OpenAI 兼容）
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-你的DeepSeekKey
# LLM_MODEL=deepseek-chat

# 方案 C：本地 Ollama（课件 P15-P23，装好 Ollama 并 ollama pull 模型后启用）
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:4b
# USE_OLLAMA_EMBEDDING=1
# OLLAMA_EMBED_MODEL=qwen3-embedding:4b

# —————————— 自定义 OpenAI 兼容服务（以上都不满足时手填）——————————
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=your-model
